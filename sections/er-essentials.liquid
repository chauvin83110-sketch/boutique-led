<section class="er er-essentials">
  <div class="er__inner">
    <h2 class="er-essentials__title" data-er-reveal>{{ section.settings.title | escape }} <em>{{ section.settings.title_accent | escape }}</em></h2>
    <ul class="er-essentials__list" data-er-stagger>
      {%- for block in section.blocks -%}
        <li class="er-card" {{ block.shopify_attributes }}>
          <span class="er-card__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'light' -%}
                <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="6"/><path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M6.8 25.2l2.8-2.8M22.4 9.6l2.8-2.8"/></svg>
              {%- when 'face' -%}
                <svg viewBox="0 0 32 32"><path d="M8 13c0-5 3.6-9 8-9s8 4 8 9c0 6-3.6 11-8 11s-8-5-8-11z"/><path d="M12 24v4h8v-4M12.5 13.5h2M17.5 13.5h2M13.5 18.5c1.5 1 3.5 1 5 0"/></svg>
              {%- when 'hands' -%}
                <svg viewBox="0 0 32 32"><path d="M5 8h9c1.1 0 2 .9 2 2v15c0-1.700-1.300-3-3-3H5V8zM27 8h-9c-1.1 0-2 .9-2 2v15c0-1.7 1.300-3 3-3h8V8z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32"><path d="M16 4l9 3.500v7c0 6-3.8 10.800-9 13.500-5.200-2.700-9-7.500-9-13.500v-7L16 4z"/><path d="M11.5 16l3.2 3.2 5.800-6.200"/></svg>
            {%- endcase -%}
          </span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Éclat Rubis : l'essentiel",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "L'essentiel" },
    { "type": "text", "id": "title_accent", "label": "Titre : mots en rubis", "default": "en quatre points." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "light",
          "options": [
            { "value": "light", "label": "Lumière" },
            { "value": "face", "label": "Visage et cou" },
            { "value": "hands", "label": "Livre (mains libres)" },
            { "value": "shield", "label": "Garantie" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "La lumière des instituts" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Lumière rouge et proche infrarouge." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Éclat Rubis : l'essentiel" }]
}
{% endschema %}

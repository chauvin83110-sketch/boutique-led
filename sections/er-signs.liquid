<section class="er er-signs">
  <div class="er__inner">
    <div class="er-signs__head">
      <h2 class="er-signs__title" data-er-reveal>{{ section.settings.title | escape }}</h2>
      <div data-er-reveal>{{ section.settings.text }}</div>
    </div>
    <ul class="er-signs__list">
      {%- for block in section.blocks -%}
        <li class="er-signs__item" data-er-reveal {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Éclat Rubis : constat",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce n'est pas dans votre tête." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Autour de 45 ans, beaucoup de femmes remarquent la même chose. Les crèmes habituelles ne suffisent plus, et l'institut à 80 € la séance ne tient pas sur la durée.</p>" }
  ],
  "blocks": [
    {
      "type": "sign",
      "name": "Signe",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Le teint" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Plus terne le matin, même après une bonne nuit." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Éclat Rubis : constat",
      "blocks": [
        { "type": "sign", "settings": { "title": "Le teint", "text": "Plus terne le matin, même après une bonne nuit." } },
        { "type": "sign", "settings": { "title": "Le bas du visage", "text": "Il se relâche, et ça se voit surtout sur les photos de profil." } },
        { "type": "sign", "settings": { "title": "Le cou", "text": "Il marque plus vite que le visage, et on l'oublie souvent." } }
      ]
    }
  ]
}
{% endschema %}

<section class="er er-guarantee">
  <div class="er__inner">
    <div class="er-guarantee__seal" data-er-reveal><strong>{{ section.settings.days }}</strong><span>jours</span></div>
    <h2 class="er-guarantee__title" data-er-reveal>{{ section.settings.title | escape }}</h2>
    <div data-er-reveal>{{ section.settings.text }}</div>
    {%- if section.settings.link_label != blank -%}
      <a class="er-button er-button--light" href="{{ section.settings.link | default: routes.root_url }}" data-er-reveal>{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Éclat Rubis : garantie",
  "tag": "div",
  "settings": [
    { "type": "number", "id": "days", "label": "Durée (jours)", "default": 30 },
    { "type": "text", "id": "title", "label": "Titre", "default": "Essayez-le 30 jours." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Si vous ne voyez pas la différence, renvoyez-le : on vous rembourse. Cette garantie s'ajoute au droit de rétractation légal de 14 jours.</p>" },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Lire la politique de retour" },
    { "type": "url", "id": "link", "label": "Adresse du lien", "default": "/policies/refund-policy" }
  ],
  "presets": [{ "name": "Éclat Rubis : garantie" }]
}
{% endschema %}

<section class="er er-faq">
  <div class="er__inner er-faq__grid">
    <h2 class="er-faq__title">{{ section.settings.title | escape }}</h2>
    <div>
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="er-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Éclat Rubis : questions",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Vos questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Éclat Rubis : questions",
      "blocks": [
        { "type": "question", "settings": { "question": "Est-ce que ça chauffe ?", "answer": "<p>Non. La lumière est douce, on sent à peine une légère chaleur.</p>" } },
        { "type": "question", "settings": { "question": "Au bout de combien de temps voit-on un effet ?", "answer": "<p>Chaque peau est différente. Il faut une utilisation régulière, 3 à 5 fois par semaine, sur plusieurs semaines.</p>" } },
        { "type": "question", "settings": { "question": "J'ai la peau sensible, est-ce adapté ?", "answer": "<p>Il n'y a ni produit ni frottement. En cas de doute (photosensibilité, traitement, grossesse, épilepsie), demandez l'avis de votre médecin.</p>" } },
        { "type": "question", "settings": { "question": "Quand vais-je le recevoir ?", "answer": "<p>La livraison est offerte et suivie. Votre masque arrive au plus tard 12 jours ouvrés après votre commande.</p>" } },
        { "type": "question", "settings": { "question": "Et s'il ne me convient pas ?", "answer": "<p>Vous avez 30 jours pour l'essayer. S'il ne vous convient pas, renvoyez-le et on vous rembourse.</p>" } }
      ]
    }
  ]
}
{% endschema %}

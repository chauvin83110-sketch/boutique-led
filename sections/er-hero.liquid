{%- liquid
  assign product_url = routes.all_products_collection_url
  if section.settings.product != blank
    assign product_url = section.settings.product.url
  endif
-%}
<section class="er er-hero" aria-labelledby="ErHeroTitle-{{ section.id }}">
  <div class="er-hero__glow" aria-hidden="true"></div>
  <div class="er__inner er-hero__grid">
    <div>
      <{{ section.settings.heading_tag }} class="er-hero__title" id="ErHeroTitle-{{ section.id }}">
        {%- if section.settings.line_1 != blank -%}<span class="er-line"><span>{{ section.settings.line_1 | escape }}</span></span>{%- endif -%}
        {%- if section.settings.line_2 != blank -%}<span class="er-line"><span>{{ section.settings.line_2 | escape }}</span></span>{%- endif -%}
        {%- if section.settings.line_3 != blank -%}<span class="er-line"><span>{{ section.settings.line_3 | escape }}</span></span>{%- endif -%}
      </{{ section.settings.heading_tag }}>
      {%- if section.settings.text != blank -%}
        <div class="er-hero__text" data-er-reveal>{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="er-button" href="{{ product_url }}" data-er-reveal>{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
      <ul class="er-hero__proof" data-er-reveal>
        {%- for i in (1..3) -%}
          {%- assign key = 'proof_' | append: i -%}
          {%- if section.settings[key] != blank -%}<li>{{ section.settings[key] | escape }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="er-hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 800px) 45vw, 90vw', widths: '400, 700, 1000, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Éclat Rubis : héros",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo (portrait, 4:5)" },
    { "type": "product", "id": "product", "label": "Produit du bouton" },
    { "type": "select", "id": "heading_tag", "label": "Niveau du titre", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }], "default": "h1" },
    { "type": "text", "id": "line_1", "label": "Titre, ligne 1", "default": "Ma peau a changé" },
    { "type": "text", "id": "line_2", "label": "Titre, ligne 2", "default": "en quelques mois." },
    { "type": "text", "id": "line_3", "label": "Titre, ligne 3", "default": "Ma routine aussi." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un masque LED lumière rouge et proche infrarouge pour le visage et le cou. 10 minutes chez soi, pour une peau qui a l'air reposée.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir le masque" },
    { "type": "text", "id": "proof_1", "label": "Réassurance 1", "default": "Satisfaite ou remboursée 30 jours" },
    { "type": "text", "id": "proof_2", "label": "Réassurance 2", "default": "Livraison offerte et suivie" },
    { "type": "text", "id": "proof_3", "label": "Réassurance 3", "default": "Visage et cou en une séance" }
  ],
  "presets": [{ "name": "Éclat Rubis : héros" }]
}
{% endschema %}
